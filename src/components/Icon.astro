const glyph = icons[name];
if (!glyph) throw new Error(`Icon "${name}" is not in the set. Add it to src/components/Icon.astro.`);
---

<svg
  class:list={['icon-duotone', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path class="icon-field" d={glyph.fill} fill="currentColor" stroke="none" />
  <path d={glyph.stroke} />
</svg>

<style>
  .icon-duotone .icon-field {
    opacity: 0.16;
    transition: opacity 0.2s ease;
  }
  :global(a:hover) .icon-duotone .icon-field,
  :global(.service-link-card:hover) .icon-duotone .icon-field,
  :global(.icp-card:hover) .icon-duotone .icon-field {
    opacity: 0.28;
  }
  @media (prefers-reduced-motion: reduce) {
    .icon-duotone .icon-field { transition: none; }
  }
</style>
