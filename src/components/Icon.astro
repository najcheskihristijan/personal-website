---
/**
 * Duotone icon set.
 *
 * Every glyph is built the same way: a soft filled shape carrying the thing
 * being worked on (a page, a globe, a store, a report), with crisp linework on
 * top carrying the work being done to it. That split is what makes twenty
 * separate drawings read as one family.
 *
 * Both layers inherit currentColor, so a glyph adapts to hover, dark mode, and
 * the gradient tiles on the homepage without per-surface overrides.
 */
interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

