---
import BlogCard from '../components/BlogCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts } from '../data/blog-posts';

// Rendered on demand so a direct hit on /404 works. As a prerendered page the
// SSR router had no page function for that path and returned a 500, which is
// how it behaves in production today.
export const prerender = false;

// Articles come from the canonical post data rather than a hand-copied list,
// which is how these cards drifted out of sync with the blog in the first
// place — no artwork, and titles that had to be maintained twice.
const blogPosts = Object.entries(posts)
  .filter(([, post]) => new Date(post.date) <= new Date())
  .sort(([, a], [, b]) => new Date(b.date).valueOf() - new Date(a.date).valueOf())
  .slice(0, 3)
  .map(([slug, post]) => ({ slug, ...post }));
---

<BaseLayout
  title="404 | Page Not Found | Hristijan Najcheski"
  description="The page you're looking for doesn't exist. But don't worry — here are some helpful resources to get you back on track."
>
  <section class="error-page">
    <div class="container">
      <div class="error-code">
        <span class="text-gradient">4</span>0<span class="text-gradient-orange">4</span>
      </div>
      <h1>This page wandered off the SERPs</h1>
      <p>
        The page you're looking for doesn't exist — it might have been moved,
        renamed, or it never existed in the first place. Kind of like ranking
        on page 2 of Google. 😉
      </p>
      <div style="display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary btn-lg">Back to Homepage</a>
        <a href="/services/" class="btn btn-secondary btn-lg">View Services →</a>
      </div>

      <div class="error-suggestions">
        <h2>While you're here, check out <span class="text-gradient">these articles</span></h2>
        <div class="blog-grid" style="margin-top: var(--space-6);">
          {blogPosts.map((post) => (
            <BlogCard slug={post.slug} title={post.title} description={post.description} tag={post.tag} date={post.date} readTime={post.readTime} image={post.image} />
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
